# Government of India Open Government Data (OGD) API Configuration
# Get your API key by registering at https://data.gov.in/
DATA_GOV_API_KEY=your_api_key_here

# AGMARKNET Daily Mandi Prices Resource ID
# Default current resource ID for "Current Daily Price of Various Commodities from Various Markets (Mandi)"
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional Open-Meteo / Weather API configuration (if needed later)
WEATHER_LATITUDE=12.9716
WEATHER_LONGITUDE=77.5946

# PostgreSQL Database Configuration
# Option A: Full Connection URI
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/agrovision

# Option B: Individual connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrovision
DB_USER=postgres
DB_PASSWORD=your_password_here
